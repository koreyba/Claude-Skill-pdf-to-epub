{
  "description": "Configuration for academic papers with 2-column layout",
  "page_ranges": {
    "skip": [1],
    "content": [2, -1],
    "endnotes": null
  },
  "exclude_regions": {
    "top": 0.08,
    "bottom": 0.08,
    "left": 0.02,
    "right": 0.02
  },
  "multi_column": {
    "enabled": true,
    "column_count": 2,
    "threshold": 0.4
  },
  "reading_order_strategy": "xy_cut",
  "heading_detection": {
    "font_size_threshold": 1.15,
    "max_heading_levels": 4
  },
  "footnote_processing": {
    "enabled": true,
    "patterns": ["bracket", "paren"],
    "generate_backlinks": true
  },
  "image_optimization": {
    "enabled": true,
    "max_width": 1000,
    "max_height": 1400,
    "jpeg_quality": 80,
    "convert_png_to_jpeg": false
  },
  "metadata": {
    "language": "en"
  }
}
