{
  "description": "Configuration for fiction books with simple single-column layout",
  "page_ranges": {
    "skip": [1, 2],
    "content": [3, -3],
    "endnotes": [-2, -1]
  },
  "exclude_regions": {
    "top": 0.05,
    "bottom": 0.05,
    "left": 0.0,
    "right": 0.0
  },
  "multi_column": {
    "enabled": false,
    "column_count": 1
  },
  "reading_order_strategy": "y_sort",
  "heading_detection": {
    "font_size_threshold": 1.2,
    "max_heading_levels": 3
  },
  "footnote_processing": {
    "enabled": true,
    "generate_backlinks": true
  },
  "image_optimization": {
    "enabled": true,
    "max_width": 1200,
    "max_height": 1600,
    "jpeg_quality": 85,
    "convert_png_to_jpeg": false
  },
  "metadata": {
    "language": "en"
  }
}
